POSTGRES_USER=zukkor
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=zukkor_db
DATABASE_URL=postgresql+asyncpg://zukkor:your_strong_password@db:5432/zukkor_db

SECRET_KEY=your-256-bit-secret-key-change-in-production
# Admin panel (SQLAdmin) sessiya cookie'si uchun ALOHIDA kalit - SECRET_KEY
# bilan bir xil qiymat bo'lmasin.
ADMIN_SESSION_SECRET=your-different-256-bit-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2 — avatar rasmlarini doimiy saqlash (bo'sh bo'lsa lokal
# diskka tushib qolinadi, faqat dev uchun).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zukkor-avatars
R2_PUBLIC_BASE_URL=https://your-bucket-public-url.r2.dev

# Admin panel (SQLAdmin, /admin) — bo'sh qoldirilmasin, ilova ular
# o'rnatilmasa umuman ishga tushmaydi.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Gemini — hujjatdan AI orqali quiz generatsiya qilish uchun (aistudio.google.com).
# Bo'sh bo'lsa ilova ishga tushadi, lekin /ai-quiz/generate ishlamaydi.
GEMINI_API_KEY=

# Google orqali kirish (Firebase). Render'da "Secret File" sifatida
# /etc/secrets/firebase-service-account.json'ga yuklanadi - Railway kabi
# secret-file'ni qo'llab-quvvatlamaydigan hostlarda buning o'rniga xizmat
# hisobi JSON faylining TO'LIQ MATNINI shu o'zgaruvchiga qo'yish kifoya.
# Ikkalasi ham bo'sh bo'lsa, Google kirish o'chiq qoladi.
FIREBASE_SERVICE_ACCOUNT_JSON=
